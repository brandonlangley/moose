[Tests]
  design = 'Sampler.md'
  issues = '#22766'

  [sampler_input_pairs]
    type = GoogleTest
    unit_test = StochasticToolsMooseServerTest.PlottingSamplerInputPairs
    requirement = 'The system shall preserve paired values and input row order when plotting a static sampler design.'
  []

  [sampler_input_rows]
    type = GoogleTest
    unit_test = StochasticToolsMooseServerTest.PlottingSamplerInputRows
    requirement = 'The system shall bound static sampler previews and include the first and last input rows.'
  []

  [sampler_input_columns]
    type = GoogleTest
    unit_test = StochasticToolsMooseServerTest.PlottingSamplerInputColumns
    requirement = 'The system shall preserve the configured column selection and order when plotting CSV sampler inputs.'
  []

  [sampler_input_vectors]
    type = GoogleTest
    unit_test = StochasticToolsMooseServerTest.PlottingSamplerInputVectors
    requirement = 'The system shall preview declared constant Reporter vectors without executing or resizing their sampler.'
  []

  [sampler_random_draws]
    type = GoogleTest
    unit_test = StochasticToolsMooseServerTest.PlottingSamplerRandomDraws
    requirement = 'The system shall limit indexed random draws while preserving the sampled values of displayed input columns.'
  []

  [sampler_latin_hypercube]
    type = GoogleTest
    unit_test = StochasticToolsMooseServerTest.PlottingSamplerLatinHypercube
    requirement = 'The system shall preview Latin hypercube strata without changing the design used by its first execution.'
  []

  [sampler_nested_monte_carlo]
    type = GoogleTest
    unit_test = StochasticToolsMooseServerTest.PlottingSamplerNestedMonteCarlo
    requirement = 'The system shall preserve outer-loop replication when plotting a nested Monte Carlo input design.'
  []

  [sampler_morris]
    type = GoogleTest
    unit_test = StochasticToolsMooseServerTest.PlottingSamplerMorris
    requirement = 'The system shall plot complete Morris input trajectories using the configured sampler values.'
  []

  [sampler_sobol]
    type = GoogleTest
    unit_test = StochasticToolsMooseServerTest.PlottingSamplerSobol
    requirement = 'The system shall plot Sobol base and hybrid matrix blocks using the configured sampler values.'
  []

  [sampler_sobol_resampling]
    type = GoogleTest
    unit_test = StochasticToolsMooseServerTest.PlottingSamplerSobolResampling
    requirement = 'The system shall include complementary Sobol hybrid blocks when resampling is enabled.'
  []
[]
