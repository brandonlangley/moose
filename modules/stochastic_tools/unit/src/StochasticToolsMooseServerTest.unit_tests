[Tests]
  design = 'Sampler.md'
  issues = '#22766'

  [sampler_input_pairs]
    type = GoogleTest
    unit_test = StochasticToolsMooseServerTest.PlottingSamplerInputPairs
    requirement = 'The system shall preserve paired values and input row order when plotting a static sampler design.'
  []

  [sampler_input_rows]
    type = GoogleTest
    unit_test = StochasticToolsMooseServerTest.PlottingSamplerInputRows
    requirement = 'The system shall bound static sampler previews and include the first and last input rows.'
  []

  [sampler_input_columns]
    type = GoogleTest
    unit_test = StochasticToolsMooseServerTest.PlottingSamplerInputColumns
    requirement = 'The system shall preserve the configured column selection and order when plotting CSV sampler inputs.'
  []

  [sampler_input_vectors]
    type = GoogleTest
    unit_test = StochasticToolsMooseServerTest.PlottingSamplerInputVectors
    requirement = 'The system shall preview declared constant Reporter vectors without executing or resizing their sampler.'
  []

  [sampler_random_draws]
    type = GoogleTest
    unit_test = StochasticToolsMooseServerTest.PlottingSamplerRandomDraws
    requirement = 'The system shall limit indexed random draws while preserving the sampled values of displayed input columns.'
  []

  [sampler_latin_hypercube]
    type = GoogleTest
    unit_test = StochasticToolsMooseServerTest.PlottingSamplerLatinHypercube
    requirement = 'The system shall preview Latin hypercube strata without changing the design used by its first execution.'
  []

  [sampler_nested_monte_carlo]
    type = GoogleTest
    unit_test = StochasticToolsMooseServerTest.PlottingSamplerNestedMonteCarlo
    requirement = 'The system shall preserve outer-loop replication when plotting a nested Monte Carlo input design.'
  []

  [sampler_morris]
    type = GoogleTest
    unit_test = StochasticToolsMooseServerTest.PlottingSamplerMorris
    requirement = 'The system shall plot complete Morris input trajectories using the configured sampler values.'
  []

  [sampler_sobol]
    type = GoogleTest
    unit_test = StochasticToolsMooseServerTest.PlottingSamplerSobol
    requirement = 'The system shall plot Sobol base and hybrid matrix blocks using the configured sampler values.'
  []

  [sampler_sobol_resampling]
    type = GoogleTest
    unit_test = StochasticToolsMooseServerTest.PlottingSamplerSobolResampling
    requirement = 'The system shall include complementary Sobol hybrid blocks when resampling is enabled.'
  []

  [sampler_quadrature_weights]
    type = GoogleTest
    unit_test = StochasticToolsMooseServerTest.PlottingSamplerQuadratureWeights
    requirement = 'The system shall preserve signed, unnormalized quadrature weights in input previews.'
  []

  [sampler_polynomial_bases]
    type = GoogleTest
    unit_test = StochasticToolsMooseServerTest.PlottingSamplerPolynomialBases
    requirement = 'The system shall evaluate configured polynomial bases in the coordinates of their input distributions.'
  []

  [sampler_marginals]
    type = GoogleTest
    unit_test = StochasticToolsMooseServerTest.PlottingSamplerMarginals
    requirement = 'The system shall count repeated input rows and include the upper bin endpoint in marginal previews.'
  []

  [sampler_constant_marginals]
    type = GoogleTest
    unit_test = StochasticToolsMooseServerTest.PlottingSamplerConstantMarginals
    requirement = 'The system shall keep constant input marginals visible within finite plotting ranges.'
  []

  [sampler_correlations]
    type = GoogleTest
    unit_test = StochasticToolsMooseServerTest.PlottingSamplerCorrelations
    requirement = 'The system shall preserve signed sample correlations and omit pairs containing constant input columns.'
  []

  [sampler_constant_correlations]
    type = GoogleTest
    unit_test = StochasticToolsMooseServerTest.PlottingSamplerConstantCorrelations
    requirement = 'The system shall treat correlation with a constant input column as undefined despite rounding.'
  []

  [distribution_quantiles]
    type = GoogleTest
    unit_test = StochasticToolsMooseServerTest.PlottingDistributionQuantiles
    requirement = 'The system shall preview distribution quantiles, the median, and the actual probability mass between interval endpoints.'
    design = 'syntax/Distributions/index.md'
  []

  [distribution_inversecdf]
    type = GoogleTest
    unit_test = StochasticToolsMooseServerTest.PlottingDistributionInverseCDF
    requirement = 'The system shall display the actual cumulative probability of approximate distribution quantiles.'
    design = 'syntax/Distributions/index.md'
  []

  [distribution_upper_tail]
    type = GoogleTest
    unit_test = StochasticToolsMooseServerTest.PlottingDistributionUpperTail
    requirement = 'The system shall preview upper-tail probabilities by subtracting the configured cumulative probability from one.'
    design = 'syntax/Distributions/index.md'
  []

  [distribution_log_density]
    type = GoogleTest
    unit_test = StochasticToolsMooseServerTest.PlottingDistributionLogDensity
    requirement = 'The system shall keep positive distribution densities visible on logarithmic axes without changing the ordinary density preview.'
    design = 'syntax/Distributions/index.md'
  []

  [distribution_comparisons]
    type = GoogleTest
    unit_test = StochasticToolsMooseServerTest.PlottingDistributionComparisons
    requirement = 'The system shall place the requested distribution first when comparing configured input distributions.'
    design = 'syntax/Distributions/index.md'
  []

  [sampler_priors]
    type = GoogleTest
    unit_test = StochasticToolsMooseServerTest.PlottingSamplerPriors
    requirement = 'The system shall preview configured Bayesian priors and initial values without generating chain samples.'
  []
[]
